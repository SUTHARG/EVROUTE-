# Route.ev Configuration Template
# Copy this file to .env and adjust variables as needed.

# ==============================================================================
# DEMO MODE
# ==============================================================================
# In demo mode (true), advanced features are hidden:
# Analysis tab, Pareto chart, algorithm statistics, benchmark labels, and Advanced Settings.
# Set to false to enable full developer/research features.
NEXT_PUBLIC_DEMO_MODE=false

# ==============================================================================
# VEHICLE RANGE CALIBRATION
# ==============================================================================
# When false (default), vehicles use normalized 250 km demo range.
# When true, vehicles use manufacturer rated consumption / real_range_km.
USE_CAR_SPECIFIC_RANGE=false

# ==============================================================================
# LIVE STATION PROVIDER KEYS (NEVER COMMIT REAL KEYS)
# ==============================================================================
# Google Places API (New) key
GOOGLE_MAPS_API_KEY=

# Open Charge Map API key
OCM_API_KEY=

# ==============================================================================
# CONNECTOR STANDARDS
# ==============================================================================
# Allow stations with unknown connectors to be included in planner graph
ALLOW_UNKNOWN_CONNECTORS=false
